{
  "name": "quant-web",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.mjs",
    "contracts:generate": "openapi-typescript contracts/api.openapi.json -o src/generated/api.d.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "ace-builds": "1.43.3",
    "echarts": "6.1.0",
    "font-awesome": "4.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/",
    "CONTRIBUTING.md"
  ]
}
