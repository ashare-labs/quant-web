{
  "name": "quant-web",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "verify:portfolio": "node --experimental-strip-types scripts/verify-portfolio.mjs",
    "package": "node scripts/package.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "ace-builds": "1.43.3",
    "echarts": "6.1.0",
    "font-awesome": "4.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/",
    "CONTRIBUTING.md"
  ]
}
